import { getProducts } from "@/lib/data";

export default async function sitemap() {
  const products = await getProducts();

  return [
    {
      url: "https://shumbolla.uz",
      lastModified: new Date(),
    },
    ...products.map((p: any) => ({
      url: `https://shumbolla.uz/product/${p.slug}`,
      lastModified: new Date(),
    })),
  ];
}